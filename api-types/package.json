{
  "name": "@mattermost/desktop-api",
  "version": "6.2.0-1",
  "description": "Shared types for the OKR Best Desktop App API",
  "keywords": [
    "okrbest",
    "mattermost"
  ],
  "homepage": "https://github.com/okrbest/okrbest-desktop",
  "license": "MIT",
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "github:okrbest/okrbest-desktop",
    "directory": "api-types"
  },
  "peerDependencies": {
    "typescript": "^4.3.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc --build --verbose",
    "run": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf tsconfig.tsbuildinfo ./lib",
    "prepublishOnly": "npm run build && rm -rf ./lib/tsconfig.tsbuildinfo"
  }
}
